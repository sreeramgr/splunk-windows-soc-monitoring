<form version="1.1" theme="dark">
  <label>Windows SOC Monitoring Dashboard</label>
  <description>Monitors Windows security events, suspecious activity, account changes, failed logins, service installations and triggered detections.</description>
  <fieldset submitButton="false">
    <input type="time" token="field1">
      <label></label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Total Windows Events</title>
      <single>
        <search>
          <query>index=soc_lab
| stats count AS "Total Events"</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
          <sampleRatio>1</sampleRatio>
        </search>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="trellis.enabled">0</option>
        <option name="trellis.scales.shared">1</option>
        <option name="trellis.size">medium</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Failed Login Attempts</title>
      <single>
        <search>
          <query>index=soc_lab EventCode=4625
| stats count AS "Failed Login Attempts"</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051", "0x0877a6", "0xf8be34", "0xf1813f", "0xdc4e41"]</option>
        <option name="rangeValues">[0,30,70,100]</option>
        <option name="showSparkline">1</option>
        <option name="showTrendIndicator">1</option>
        <option name="trellis.enabled">0</option>
        <option name="trellis.scales.shared">1</option>
        <option name="trellis.size">medium</option>
        <option name="trendColorInterpretation">standard</option>
        <option name="trendDisplayMode">absolute</option>
        <option name="unitPosition">after</option>
        <option name="useColors">0</option>
        <option name="useThousandSeparators">1</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top Windows Security Event Codes</title>
        <search>
          <query>index=soc_lab source="WinEventLog:Security"
| stats count AS Events by EventCode
| sort - Events
| head 10</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Security Events Over Time</title>
        <search>
          <query>index=soc_lab source="WinEventLog:Security"
| timechart span=1h count AS "Security Events"</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Recent Suspicious Windows Activity</title>
        <search>
          <query>index=soc_lab (
    EventCode=4625 OR EventCode=4720 OR EventCode=4722 OR EventCode=4724
    OR EventCode=4726 OR EventCode=4732 OR EventCode=4733 OR EventCode=7045
)
| eval Activity=case(
    EventCode=4625, "Failed login",
    EventCode=4720, "User account created",
    EventCode=4722, "User account enabled",
    EventCode=4724, "Password reset attempted",
    EventCode=4726, "User account deleted",
    EventCode=4732, "Member added to local group",
    EventCode=4733, "Member removed from local group",
    EventCode=7045, "New Windows service installed"
)
| table _time host EventCode Activity Account_Name Member_Name Group_Name Service_Name
| sort - _time
| head 20</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Windows Events by Log Source</title>
        <search>
          <query>index=soc_lab
| stats count AS Events by source
| sort - Events</query>
          <earliest>$field1.earliest$</earliest>
          <latest>$field1.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</form>